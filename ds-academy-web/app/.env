# Copy to .env and fill in real values before running `npm run setup` / `docker compose up`.
# Reconstructed from SETUP.md / GO_LIVE.md — the original .env.example never made it into
# git history (Mentora's root .gitignore was eating it before this repo existed).

# Elite (default) or Pro — gates Pro-only modules across sidebar, routes and API.
SITE_TIER=elite

# Supabase Postgres — pooled connection (Supavisor, port 6543) for runtime queries.
#DATABASE_URL="postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — required for `prisma migrate`, cannot go through the pooler.
#DIRECT_URL="postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://ds_panel_user:DsScience%40123@localhost:5432/ds_panel"
DIRECT_URL="postgresql://ds_panel_user:DsScience%40123@localhost:5432/ds_panel"

# Supabase Storage (file uploads — Settings > API on the Supabase dashboard).
# service_role / "secret" key only — never the anon/publishable one, this
# bypasses row-level security to write to the `uploads` bucket server-side.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# openssl rand -base64 48
AUTH_SECRET=<openssl rand -base64 48>

POSTGRES_PASSWORD=<a long random password>

NEXT_PUBLIC_SITE_URL=https://dsscienceacademy.com

SEED_ADMIN_EMAIL=office@dsscienceacademy.com
SEED_ADMIN_PASSWORD=<a strong temporary password>

ENQUIRY_NOTIFY_TO=office@dsscienceacademy.com
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX