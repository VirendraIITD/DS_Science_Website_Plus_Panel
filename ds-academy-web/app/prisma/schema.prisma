// DS Science Academy — data model
// Mirrors PRD §5. Tier markers: [E] = Elite (and Pro), [P] = Pro only.
// Pro-only models stay in the schema for both tiers so that upgrading an Elite
// install to Pro is an env-var flip, not a migration (PRD §0 "Order").

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Supabase Supavisor, port 6543). Every runtime query
  // goes through this so a serverless/container restart cannot exhaust the
  // database's connection slots.
  url      = env("DATABASE_URL")
  // Direct connection (port 5432). Prisma needs an unpooled link to run
  // migrations; a transaction pooler cannot hold the advisory locks they use.
  // On a plain self-hosted Postgres, point both at the same URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CourseCategory {
  NEET
  JEE
  FOUNDATION
  BOARD
}

enum NewsType {
  NOTICE
  EVENT
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum BannerStatus {
  LIVE
  HIDDEN
}

enum DownloadCategory {
  BROCHURE
  SYLLABUS
  PYQ
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  DEMO
  ADMITTED
  LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  WALK_IN
  REFERRAL
  PHONE
  IMPORT
  OTHER
}

enum PackageType {
  RECORDED
  LIVE
  TEST_SERIES
}

enum ClassLevel {
  ELEMENTARY
  CLASS_6
  CLASS_7
  CLASS_8
  CLASS_9
  CLASS_10
  CLASS_11
  CLASS_12
  /// Deprecated — "Dropper" no longer appears anywhere on the site. Kept
  /// only so courses/packages already tagged with it don't break; filtered
  /// out of every public/admin render via HIDDEN_CLASS_LEVELS in lib/format.ts.
  DROPPER
  /// Superseded by the explicit CLASS_6..CLASS_10 values above — kept only
  /// so existing courses tagged with the old generic "Foundation" bucket
  /// don't break. Not offered as a choice in the admin form any more.
  FOUNDATION
}

enum DemoMode {
  ONLINE
  CENTRE
}

enum DemoStatus {
  UPCOMING
  DONE
  NO_SHOW
  CANCELLED
}

enum BranchStatus {
  ACTIVE
  SETUP
  CLOSED
}

enum StaffRoleName {
  SUPER_ADMIN
  COUNSELLOR
  EDITOR
}

enum BroadcastChannel {
  WHATSAPP
  SMS
}

enum BroadcastStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
  SIMULATED
}

// ---------------------------------------------------------------------------
// [E] Site-wide settings — single row (id = 1), edited from Admin › Settings
// ---------------------------------------------------------------------------

model SiteSettings {
  id             Int      @id @default(1)
  instituteName  String   @default("DS Science Academy")
  tagline        String   @default("Trusted NEET, JEE & Foundation coaching — Gangapur City.")
  about          String   @default("")
  address        String   @default("Gangapur City, Rajasthan")
  city           String   @default("Gangapur City")
  state          String   @default("Rajasthan")
  pincode        String   @default("")
  phones         String[] @default([])
  emails         String[] @default([])
  whatsappNumber String   @default("")
  mapEmbed       String   @default("")
  officeHours    String   @default("9:00 am – 7:00 pm, Monday to Saturday")

  // Page copy blocks that used to be hardcoded in the page templates.
  demoIntro      String @default("")
  demoParentNote String @default("")
  predictorNote  String @default("")

  // Home page — bottom "Admissions are open" CTA section.
  admHeading String   @default("Admissions are open for 2026-27")
  admNote    String   @default("Leave your number and someone from the office will call you back — usually the same day. You can also simply walk in; the front desk is open 9 am to 7 pm.")
  admPoints  String[] @default(["Free demo class before you decide", "Fees payable in 2 or 3 instalments", "Scholarship test — up to 100% fee waiver", "Hostel & PG guidance for outstation families"])

  // Courses listing page — header stats, the "what's included" checklist,
  // and the bottom "Still not sure" CTA, all previously hardcoded.
  coursesStatBatchSize   String   @default("40")
  coursesStatEnrolled    String   @default("2,500+")
  coursesStatSelections  String   @default("184")
  coursesIncludePoints   String[] @default(["Printed modules for every subject", "Daily Practice Sheets (DPP)", "Previous year question book", "Weekly tests with detailed analysis", "Doubt counter, open all day", "Monthly parent report", "Library & reading room, 8 am – 8 pm", "Fees payable in 2 or 3 instalments"])
  coursesCtaHeading      String   @default("Still not sure which one?")
  coursesCtaNote         String   @default("Come and sit through a free demo class. Attend the batch you are considering, meet the teacher, and decide after — not before. No fee, no obligation.")
  coursesCtaPoints       String[] @default(["Free demo class, any batch", "Honest advice, even if it is \"wait a year\"", "Scholarship test — up to 100% fee waiver", "Sibling discount of 10% on the second admission"])

  // Results page — bottom "Next year, your name could be on this page" CTA.
  resultsAdmHeading String @default("Next year, your name could be on this page.")
  resultsAdmNote    String @default("Admissions for 2026-27 are open. Batches are capped at 40 and they fill in the order admissions are confirmed. Leave your number and the office will call you back — usually the same day.")

  // Results page — the 4 stat-strip numbers (Total/NEET/JEE selections, Years
  // of results). Left blank, each falls back to a live count from the Topper
  // rows — not every selection has to have a Topper card uploaded for the
  // count to be right, so an admin can override any of these manually.
  resultsStatTotalOverride String @default("")
  resultsStatNeetOverride  String @default("")
  resultsStatJeeOverride   String @default("")
  resultsStatYearsOverride String @default("")

  // Home page — small "From the Director's Desk" banner, links through to
  // the Founders page.
  directorDeskEnabled  Boolean @default(false)
  directorDeskHeading  String  @default("From the Director's Desk")
  directorDeskNote     String  @default("A short word from the people who built this place.")
  directorDeskPhotoUrl String  @default("")
  directorDeskCtaLabel String  @default("Meet our founders")
  directorDeskCtaHref  String  @default("/founders")

  // Careers page — header stats and bottom "Become part of the team" CTA.
  careersStatSince    String   @default("2014")
  careersStatTeamSize String   @default("18+")
  careersAdmHeading   String   @default("Become part of the team.")
  careersAdmNote      String   @default("Whether you're experienced faculty or just starting out — if you enjoy working with children, we'd like to talk. Send your resume below, or email it directly.")
  careersAdmPoints    String[] @default(["Every application gets a reply", "No application fee", "Screening call within 3-4 days", "Resume: careers@dsscienceacademy.com"])

  // Predictor page — bottom "Want the full picture?" CTA.
  predictorAdmHeading String   @default("Want the full picture?")
  predictorAdmNote    String   @default("A rank-to-college estimate is just the start. Our counsellors walk you through every round, every quota and every backup option — the same way we do for our own students.")
  predictorAdmPoints  String[] @default(["Round-wise college & branch list", "State quota + All-India quota explained", "Choice-filling help, not just a prediction", "Free first counselling call"])

  // Demo page — bottom "See a class before you commit" CTA.
  demoAdmHeading String   @default("See a class before you commit.")
  demoAdmNote    String   @default("This is the same offer we make every family — sit in one real class, then decide. Most parents tell us this is what actually convinced them, not the brochure.")
  demoAdmPoints  String[] @default(["Completely free, no obligation", "Same class the batch attends — nothing staged", "Confirmed the same day, usually within hours", "Parents welcome to sit in"])

  // FAQ page — bottom "Got a question, just ask" CTA.
  faqAdmHeading String @default("Got a question? Just ask.")
  faqAdmNote    String @default("Not every question has an answer on the website. Leave your number — a counsellor will call and talk it through, and if our institute isn't the right fit for your child, they'll tell you that honestly too.")

  // About page — bottom "Come and check for yourself" CTA.
  aboutAdmHeading String   @default("Come and check for yourself.")
  aboutAdmNote    String   @default("Everything on this page is easy to claim and easy to verify. Walk in, ask to see a classroom mid-class, talk to a student who is not being supervised, ask the office for last year's result list. We would rather you checked.")
  aboutAdmPoints  String[] @default(["Free demo class, any batch", "Meet the teacher who would take your batch", "Ask for the full result list — we will hand it over", "No pressure to decide on the day"])

  // Gallery page — bottom "Better still, come and see it" CTA.
  galleryAdmHeading String @default("Better still — come and see it.")
  galleryAdmNote    String @default("Photographs are taken on the good days. Walk in on an ordinary one, sit through a class, and see the place as it actually runs.")

  // Facilities page — bottom "Photos only say so much" CTA.
  facilitiesAdmHeading String @default("Photos only say so much.")
  facilitiesAdmNote    String @default("Come and walk through the building. See the classrooms with students in them, look at the library at 7 pm, ask the doubt counter a question. Fifteen minutes settles more than any brochure.")

  // Home page — "DS Stars" moving video-story marquee (Allen-style).
  starsHeading    String @default("DS Stars")
  starsSubheading String @default("Uncover the Journey to Rise and Shine")
  starsCtaLabel   String @default("Watch Videos")
  starsCtaHref    String @default("/gallery")

  // Downloads page — bottom "check your score" CTA.
  downloadsAdmHeading String @default("Solved the paper and want to check your score?")
  downloadsAdmNote    String @default("Download the answer key, mark your own paper, and then come and talk to us about what the score actually means for your rank and your college. That conversation is free too.")

  // Admissions page — hero, header stats, "what to bring" list, and bottom CTA.
  admissionsHeading            String   @default("Admissions 2026-27 are open")
  admissionsIntro              String   @default("No entrance exam to get in, no donation, no capitation fee. Every batch is capped at 40 and seats go in the order admissions are confirmed — that is the only rush there is.")
  admissionsStatSeatsPerBatch  String   @default("40")
  admissionsStatFeeInstalments String   @default("2 or 3")
  admissionsWhatToBring        String[] @default(["Last school marksheet (photocopy + original to show)", "Aadhaar card of the student (photocopy)", "Aadhaar card of a parent or guardian", "Two passport-size photographs", "Transfer certificate, if you have one", "First fee instalment — cash, UPI or card"])
  admissionsAdmHeading         String   @default("Start with a free demo class.")
  admissionsAdmNote            String   @default("The honest way to decide is to sit in one. Attend a full session with the batch you are considering, watch how the teacher handles a doubt, then make up your mind. If it is not for you, we will say so ourselves.")
  admissionsAdmPoints          String[] @default(["A real class, not a sales demo", "Parents can sit in", "Free, and no obligation after", "Fee and batch explained in the same visit"])

  // Faculty page — header stat and bottom "Meet them before you decide" CTA.
  facultyStatStudentsPerTeacher String   @default("40")
  facultyAdmHeading             String   @default("Meet them before you decide.")
  facultyAdmNote                String   @default("Book a free demo class and sit through a real session with the teacher who would be taking your batch. Ask whatever you want afterwards. No fee, no obligation, no sales pitch.")
  facultyAdmPoints              String[] @default(["Attend a full class, not a trial lecture", "Meet the subject teacher in person", "Parents are welcome to sit in", "Decide after, not before"])

  // Home page — Allen-style offer popup, shown once per browser session.
  offerPopupEnabled  Boolean   @default(false)
  offerPopupKicker   String    @default("ADMISSIONS OPEN")
  offerPopupHeadline String    @default("Limited-time admission offer")
  offerPopupDiscount String    @default("20% OFF")
  offerPopupNote     String    @default("Enrol before the offer ends and lock in the discounted fee.")
  offerPopupCtaLabel String    @default("Enrol Now")
  offerPopupCtaHref  String    @default("/admissions")
  offerPopupExpiry   DateTime?

  facebookUrl  String @default("")
  instagramUrl String @default("")
  youtubeUrl   String @default("")
  twitterUrl   String @default("")
  linkedinUrl  String @default("")
  snapchatUrl  String @default("")

  logoUrl      String @default("")
  faviconUrl   String @default("")
  primaryColor String @default("#0f2149")
  accentColor  String @default("#e0a11a")

  // SEO defaults (PRD §9)
  seoTitle       String @default("DS Science Academy — NEET, JEE & Foundation Coaching, Gangapur City")
  seoDescription String @default("")
  seoKeywords    String @default("")
  ogImageUrl     String @default("")

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

