// ---------------------------------------------------------------------------
// [E] Leads — the Enquiry model carries the [P] CRM fields; Elite simply does
// not expose them (PRD §5 "Lead extras").
// ---------------------------------------------------------------------------

model Enquiry {
  id      String     @id @default(cuid())
  name    String
  phone   String
  email   String     @default("")
  course  String     @default("")
  classOf String     @default("")
  city    String     @default("")
  source  LeadSource @default(WEBSITE)
  message String     @default("")

  // [P] CRM extras
  stage        LeadStage @default(NEW)
  assignedToId String?
  followUpDate DateTime?

  branchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo AdminUser?  @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  notes      LeadNote[]

  @@index([stage])
  @@index([createdAt])
  @@index([assignedToId])
  @@map("enquiries")
}

/// [P] Free-text notes on a lead.
model LeadNote {
  id        String   @id @default(cuid())
  enquiryId String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  enquiry Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([enquiryId, createdAt])
  @@map("lead_notes")
}

// ---------------------------------------------------------------------------
// [E] Admin users. Elite seeds exactly one; [P] adds more with RBAC.
// ---------------------------------------------------------------------------

model AdminUser {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         StaffRoleName @default(SUPER_ADMIN)
  active       Boolean       @default(true)
  // Independent of role — a per-person toggle so any staff account can also
  // get the Mentora Counselling panel link, on top of whatever their normal
  // role already gives them (see admin/layout.tsx, Staff & Roles form).
  counsellingAccess Boolean  @default(false)
  lastLoginAt  DateTime?
  previousLoginAt DateTime?
  // Distinct from lastLoginAt/previousLoginAt: those only rotate on a fresh
  // /api/auth/login POST, which barely happens when a session stays valid
  // for days (AUTH_SESSION_HOURS) — someone active every day without ever
  // re-entering a password kept seeing "first time" / stale gaps on the
  // welcome banner. These rotate once per IST calendar day of real usage
  // instead, from admin/layout.tsx.
  lastActiveAt     DateTime?
  previousActiveAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignedLeads Enquiry[]   @relation("AssignedLeads")
  notes         LeadNote[]
  sessions      Session[]
  broadcasts    Broadcast[]
  auditLogs     AuditLog[]

  @@map("admin_users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

/// [P] Permission overrides per role. Absent row = built-in defaults apply.
model StaffRole {
  id          String        @id @default(cuid())
  role        StaffRoleName @unique
  label       String
  permissions String[]      @default([])
  updatedAt   DateTime      @updatedAt

  @@map("staff_roles")
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  action   String
  resource String
  recordId String   @default("")
  detail   String   @default("")
  at       DateTime @default(now())

  user AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([at])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// [P] Pro-only modules
// ---------------------------------------------------------------------------

model CoursePackage {
  id              String      @id @default(cuid())
  courseId        String
  title           String
  type            PackageType @default(RECORDED)
  classLevel      ClassLevel  @default(CLASS_11)
  startDate       DateTime?
  durationLabel   String      @default("")
  features        String[]    @default([])
  priceOriginal   Int         @default(0)
  priceDiscounted Int         @default(0)
  discountPct     Int         @default(0)
  highlight       Boolean     @default(false)
  order           Int         @default(0)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, classLevel, order])
  @@map("course_packages")
}

model DemoBooking {
  id          String     @id @default(cuid())
  studentName String
  phone       String
  email       String     @default("")
  course      String     @default("")
  date        DateTime
  mode        DemoMode   @default(ONLINE)
  status      DemoStatus @default(UPCOMING)
  notes       String     @default("")
  branchId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([status])
  @@map("demo_bookings")
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  category       String        @default("General")
  coverUrl       String        @default("")
  excerpt        String        @default("")
  body           String        @default("")
  seoTitle       String        @default("")
  seoDescription String        @default("")
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
  @@map("blog_posts")
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  category String  @default("General")
  order    Int     @default(0)
  active   Boolean @default(true)

  @@index([category, order])
  @@map("faqs")
}

model Branch {
  id            String       @id @default(cuid())
  name          String
  city          String
  address       String       @default("")
  phone         String       @default("")
  email         String       @default("")
  studentsCount Int          @default(0)
  mapEmbed      String       @default("")
  imageUrl      String       @default("")
  isMain        Boolean      @default(false)
  status        BranchStatus @default(ACTIVE)
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  enquiries Enquiry[]
  demos     DemoBooking[]

  @@index([order])
  @@map("branches")
}

/// Cutoff rows that power the public Rank / College Predictor (PRD §6.3).
model PredictorCutoff {
  id          String   @id @default(cuid())
  exam        String
  college     String
  courseName  String   @default("MBBS")
  state       String   @default("")
  category    String   @default("General")
  quota       String   @default("All India")
  closingRank Int
  year        Int
  createdAt   DateTime @default(now())

  @@index([exam, year, category, quota])
  @@index([closingRank])
  @@map("predictor_cutoffs")
}

model Broadcast {
  id          String           @id @default(cuid())
  channel     BroadcastChannel @default(WHATSAPP)
  segment     String
  message     String
  recipients  Int              @default(0)
  sentCount   Int              @default(0)
  failedCount Int              @default(0)
  status      BroadcastStatus  @default(DRAFT)
  error       String           @default("")
  createdById String?
  createdAt   DateTime         @default(now())
  sentAt      DateTime?

  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("broadcasts")
}

/// [P] First-party page-view counter behind the Analytics dashboard, so the
/// panel shows real numbers even before Google Analytics is wired up.
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String   @default("")
  sessionId String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@map("page_views")
}

/// Simple IP+scope counter for public-form rate limiting (PRD §9).
model RateLimitHit {
  id        String   @id @default(cuid())
  scope     String
  ip        String
  createdAt DateTime @default(now())

  @@index([scope, ip, createdAt])
  @@map("rate_limit_hits")
}
