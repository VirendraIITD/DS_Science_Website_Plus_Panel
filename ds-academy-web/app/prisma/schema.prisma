  address     String   @default("")
  quote       String   @default("")
  storyTag    String   @default("")
  order       Int      @default(0)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@index([order])
  @@map("toppers")
