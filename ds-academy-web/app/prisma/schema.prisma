model WhyPoint {
  id       String  @id @default(cuid())
  title    String
  body     String  @default("")
  icon     String  @default("")
  imageUrl String  @default("")
  order    Int     @default(0)
  active   Boolean @default(true)

  @@index([order])
  @@map("why_points")
}

/// Steps shown on the Admissions page ("How admission works").
